# ── Supabase (필수) ─────────────────────────────────────────────
# 대시보드: https://supabase.com/dashboard/project/_/settings/api
# Project URL → 아래 첫 줄,  anon public → 둘째 줄
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 API 전용(절대 NEXT_PUBLIC 붙이지 말 것). 자녀 프로필 수정·생성 등 RLS 우회 시 필요
# 대시보드 → Project Settings → API → service_role (secret). 일부 도구는 SUPABASE_SERVICE_KEY 라는 이름을 씁니다.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_KEY=

# Supabase CLI 등에서 쓰는 이름 — 없으면 NEXT_PUBLIC_SUPABASE_URL 만으로도 됩니다.
# SUPABASE_URL=

# ── AI 에이전트 (선택, 없으면 프로덕션 URL로 폴백) ───────────────
NEXT_PUBLIC_AGENT_URL=https://cooanc-agent.onrender.com

# ── 공공데이터포털 — 한국천문연구원 특일(공휴일) API (선택) ─────────
# https://www.data.go.kr 에서 발급한 인증키. 달력 동기화 `/api/public-holidays/sync` 에서만 서버가 읽습니다.
NEXT_PUBLIC_HOLIDAY_API_KEY=

# ── 콘텐츠존 운영자 화면(선택) ───────────────────────────────────
# 로그인 화면 맨 아래 「개발자 로그인」에 입력할 비밀번호.
# 별도 계정을 만들 필요 없이 이 비밀번호만으로 /admin/content 에 들어갑니다.
# (이 값이 비어 있으면 개발자 로그인은 항상 실패합니다.)
CONTENT_ADMIN_PASSWORD=

# 위 비밀번호 대신, 특정 이메일로 로그인한 상태에서도 열 수 있게 하려면 여기에 적습니다(쉼표 구분, 선택).
CONTENT_ADMIN_EMAILS=

# 사용법: 이 파일을 복사해 `.env.local` 로 저장한 뒤, 빈 칸을 본인 프로젝트 값으로 채웁니다.
